{
  "name": "pollybot",
  "version": "1.0.0",
  "description": "Safe-first prediction-market scanner and paper-trading bot for Polymarket.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cli": "tsx src/index.ts",
    "scan": "tsx src/index.ts scan",
    "diagnose": "tsx src/index.ts diagnose",
    "paper": "tsx src/index.ts paper",
    "settle": "tsx src/index.ts settle",
    "trade": "tsx src/index.ts trade",
    "live-check": "tsx src/index.ts live-check",
    "live-sweep": "tsx src/index.ts live-sweep",
    "arb": "tsx src/index.ts arb",
    "live-review-open": "tsx src/index.ts live-review-open",
    "live-opportunities": "tsx src/index.ts live-opportunities",
    "live-close-open": "tsx src/index.ts live-close-open",
    "daily": "tsx src/index.ts daily",
    "report": "tsx src/index.ts report",
    "test": "tsx --test tests/*.test.ts",
    "evaluate": "tsx --test tests/decision-engine.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "prediction-markets",
    "risk-management",
    "paper-trading",
    "react",
    "typescript"
