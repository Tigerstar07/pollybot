# Safety defaults. Leave these as-is until paper trading has a meaningful sample.
DRY_RUN=true
ENABLE_REAL_TRADING=false
ENABLE_LLM_REASONING=false

# Bankroll and hard risk limits.
BANKROLL_EUR=10
BASE_BET_EUR=0.10
KELLY_FRACTION=0.05
MAX_BET_EUR=0.20
MAX_PER_MARKET_EUR=0.30
MAX_PER_EVENT_EUR=0.30
MAX_OPEN_EXPOSURE_EUR=1.00
DAILY_LOSS_LIMIT_EUR=0.50
TOTAL_LOSS_LIMIT_EUR=2.00
MIN_EDGE=0.03
MIN_CONFIDENCE=0.45
MIN_INDEPENDENT_SOURCES=1
MAX_QUOTE_AGE_SECONDS=30
PAPER_ORDER_COOLDOWN_MINUTES=60
LIVE_ORDER_COOLDOWN_MINUTES=1440
MAX_LIVE_TRADES_PER_DAY=1
MAX_LIVE_STAKE_PER_DAY_EUR=0.20
LIVE_MIN_STAKE_EUR=0.05
ALLOW_LIVE_MIN_ORDER_TOP_UP=false
MIN_LIVE_TOP_UP_EDGE=0.06
MAX_LIVE_TOP_UP_BANKROLL_FRACTION=0.15
LIVE_MIN_PRICE=0.05
LIVE_MAX_PRICE=0.95
LIVE_INTRADAY_ENABLED=false
LIVE_INTRADAY_MAX_HOURS=36
LIVE_INTRADAY_MIN_EDGE=0.08
LIVE_INTRADAY_MIN_CONFIDENCE=0.40
LIVE_INTRADAY_MIN_PRICE=0.01
LIVE_INTRADAY_MAX_PRICE=0.98
LIVE_INTRADAY_MAX_STAKE_EUR=0.05
LIVE_OPPORTUNITY_REPORT_LIMIT=80
# Real-money directional forecasts are a separate opt-in from account/arb access.
ENABLE_DIRECTIONAL_LIVE_TRADING=false
# Require current-model, first-forecast-per-market out-of-sample skill globally and
# inside each category. The confidence bound must also show positive improvement.
LIVE_CALIBRATION_MIN_SETTLED=200
LIVE_CALIBRATION_MIN_CATEGORY_SETTLED=50
LIVE_CALIBRATION_MIN_BRIER_SKILL=0.02
LIVE_CALIBRATION_Z_SCORE=1.645
SLIPPAGE_BUFFER=0.005

# Market filters.
MIN_LIQUIDITY=100
MAX_SPREAD=0.15
MIN_HOURS_TO_END=2
MAX_DAYS_TO_END=365
LIVE_MIN_HOURS_TO_END=2
LIVE_MAX_HOURS_TO_END=8760
LIVE_NEAR_TERM_MAX_HOURS=36
LIVE_SWEEP_CANDIDATE_LIMIT=250
SCAN_MAX_EVENTS=500
SCAN_PAGE_LIMIT=100
SCAN_ALL_MARKETS=false
# Research-throughput budgets only; these do not limit bet count or euros.
SCAN_MAX_EXTERNAL_SOURCE_MARKETS=600
SCAN_MAX_NEWS_SOURCE_MARKETS=30

# Locked-payout negRisk basket lane. Disabled by default; it shares the real-money
# account gate but never bypasses fill confirmation or its own exposure caps.
ARB_ENABLED=false
ARB_MIN_PROFIT_EUR=0.05
ARB_MIN_EDGE=0.025
ARB_MAX_STAKE_EUR=2.50
ARB_MAX_OPEN_EUR=2.50
ARB_MAX_LEGS=3
ARB_MAX_DAYS_TO_END=14
ARB_EVENT_SCAN_LIMIT=25

# Storage.
DATABASE_PATH=data/pollybot.sqlite

# Official Polymarket endpoints.
POLYMARKET_FRONTEND_URL=https://polymarket.com
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Optional independent sports odds. A limited free developer tier is available.
# Sports remain research-only/skipped when this is absent.
# SPORTS_ODDS_API_KEY=
SPORTS_ODDS_API_URL=https://api.the-odds-api.com
SPORTS_ODDS_REGIONS=eu
# Quota safety: reuse one league response for 15 minutes, reject stale bookmaker
# lines, cap paid requests per scan, and preserve the last 50 monthly credits.
SPORTS_ODDS_CACHE_MINUTES=15
SPORTS_ODDS_MAX_AGE_MINUTES=30
SPORTS_ODDS_MAX_CALLS_PER_SCAN=6
SPORTS_ODDS_MIN_REMAINING=50

# Weather uses Open-Meteo and Open-Meteo Geocoding without a key. A separate
# weather key is not required unless you later add a paid provider.

# Economy/macro uses the public BLS API without a key for supported US CPI,
# unemployment, and nonfarm-payroll threshold markets.

# Tech uses official OpenAI/Anthropic status/RSS feeds without a key where those
# sources match the market wording. Culture movie/TV release-date checks need TMDB.
# TMDB_API_KEY=

# Market-cap evidence for "largest company / $X trillion valuation" markets via Financial
# Modeling Prep. Free tier is 250 requests/day, single-symbol quotes (caps cached 6h). The
# legacy /v3 API is closed to new keys, so this uses the /stable API by default.
# FMP_API_KEY=
# FMP_API_URL=https://financialmodelingprep.com

# Optional LLM reasoning. Disabled unless ENABLE_LLM_REASONING=true and a key/host exists.
# LLM_PROVIDER=openai-compatible|anthropic|gemini|ollama
# LLM_MODEL=
# OPENAI_API_KEY=
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Polymarket Live execution credentials
# POLYMARKET_PRIVATE_KEY=0x...
# POLYMARKET_FUNDER_ADDRESS=0x...
# New deposit wallets normally use 3 (POLY_1271). Existing EOA/proxy/Safe
# wallets use 0/1/2 respectively. This must match the wallet being funded.
POLYMARKET_SIGNATURE_TYPE=3
# Optional: if omitted, the official SDK derives API credentials from the signer.
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=

# Final activation requires all three exact values. Keep these safe defaults until
# `npm run live-check` passes and the account has only the intended small bankroll.
# DRY_RUN=false
# ENABLE_REAL_TRADING=true
# LIVE_TRADING_CONFIRM=I_ACCEPT_REAL_MONEY_LOSS
# ENABLE_DIRECTIONAL_LIVE_TRADING=true  # only after calibration gates pass
